# chat-rs configuration. Copy to `.env` and run — the defaults below are a
# fully working local setup (server on 127.0.0.1:3000, two rooms, alice as
# the default client). Loaded automatically from the working directory at
# startup; process env overrides `.env`, so per-client tweaks like
# `CHAT_RS_USERNAME=bob cargo run -- connect` work without editing the file.

# ---- server (chat-rs serve) ----
# `ip:port` to bind. Use 0.0.0.0:3000 to accept connections from any interface.
CHAT_RS_BIND=127.0.0.1:3000

# Rooms hosted by this server. One `name = password` per line, `#` comments.
# Names match [A-Za-z0-9_-]{1,32}. Passwords must be at least 8 chars.
# The whole multi-line value goes in one quoted string.
CHAT_RS_ROOMS="
main   = changeme
lounge = lounge-pw
"

# ---- client (chat-rs connect) ----
# `ip:port` of the server.
CHAT_RS_SERVER=127.0.0.1:3000
# Display name shown to other clients in the room.
CHAT_RS_USERNAME=alice
# Room to join. Must exist on the server (see CHAT_RS_ROOMS above).
CHAT_RS_ROOM=main

# ---- shared ----
# Password for the room being joined (client) — also fine to set on the server
# host as long as it isn't logged. Min 8 chars. If unset on the client,
# `chat-rs connect` falls back to an interactive no-echo prompt.
CHAT_RS_PASSWORD=changeme
